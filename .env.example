OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING=medium
VISION_MODEL=gpt-6-luna
TRANSCRIBE_MODEL=whisper-1
# leave WHATSAPP_TOKEN / PHONE_NUMBER_ID empty = MOCK mode (test UI at /)
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
GRAPH_API_VERSION=v27.0
VERIFY_TOKEN=choose-a-secret
APP_SECRET=
FAST_MODEL=
TEMPLATE_LANG=en
# Isolated Meta Cloud API test-number profile; run with ./run-meta-test.sh
META_TEST_ACCESS_TOKEN=
META_TEST_PHONE_NUMBER_ID=
META_TEST_RECIPIENTS=
META_TEST_ADMIN_NUMBER=
META_TEST_VERIFY_TOKEN=
META_TEST_APP_SECRET=
META_TEST_MODE=0
# comma separated, digits with country code, e.g. 905488889999
ADMIN_NUMBERS=905550000001
DEBOUNCE_SECONDS=3
MAX_TEXT_CHARS=2000
MAX_VOICE_SECONDS=300
VISION_DAILY_CAP=10
HISTORY_DAYS=14
# prices are read live from each product page; cached prices (up to this many seconds old) may only RANK/filter, anything shown or ordered is re-read now
PRICE_RANK_AGE=7200
# 0 disables the background thread that keeps the price cache warm
PRICE_WARMER=1
# optional: GRAPH_PATH=data/graph.json  STATE_DIR=.  (chat.db, orders.csv, stats csvs live here)

# --- Telegram (optional, works next to WhatsApp). Create the bot with @BotFather (/newbot) and paste its token.
TELEGRAM_TOKEN=
# any long random text: Telegram sends it with every message so only Telegram can reach /telegram/webhook
TELEGRAM_SECRET=
# the public https address of this server (your ngrok address); the webhook is registered with Telegram at every start
PUBLIC_URL=
# owner chat ids on Telegram, comma separated: message the bot "/id" to see yours
ADMIN_TELEGRAM=


# Optional local WAHA test connection (takes precedence over Meta)
WAHA_URL=http://127.0.0.1:3000
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
